    COURSE_ASSIGNMENTS ||--o{ ASSIGNED_COURSE_ROWS : "detalla (CASCADE)"
    COURSE_ASSIGNMENTS ||--o{ ADDITIONAL_COURSE_ROWS : "detalla (CASCADE)"

