# Configuración de Apache para el sitio estático (InfinityFree u otro hosting).
#
# Vite copia tal cual todo lo que hay en `public/`, así que este archivo acaba
# en `dist/.htaccess` y sube junto al resto.

# ---------------------------------------------------------- rutas del sitio
# El sitio es una SPA: /inscripcion, /portal/admin y /solicitud-titulo NO son
# carpetas en el servidor, las resuelve React Router dentro del navegador.
# Sin esta regla, entrar directo a cualquiera de esas direcciones —o recargar
# la página estando en ellas— da un 404 de Apache. Es EL fallo clásico al subir
# una SPA a un hosting compartido, y no se nota hasta que alguien recarga.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si el archivo o la carpeta existen de verdad (JS, CSS, imágenes), se sirve.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra cosa la resuelve la aplicación.
    RewriteRule . /index.html [L]
</IfModule>

# ------------------------------------------------------------------- HTTPS
# InfinityFree da certificado gratis, pero no fuerza su uso. Sin esto, quien
# escriba la dirección sin "https://" manda su carné y su token de sesión en
# texto plano por la red.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# -------------------------------------------------- cabeceras de seguridad
# Las mismas ideas que aplica el backend, aquí para la parte que sirve Apache.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # `camera=(self)` y no `camera=()`: la solicitud de título toma la
    # fotografía con la cámara del dispositivo. Apagarla del todo rompería
    # esa pantalla.
</IfModule>

# ------------------------------------------------------------------- caché
# Los archivos de dist llevan un hash en el nombre (index-a1b2c3.js), así que
# pueden cachearse para siempre: al publicar una versión nueva cambia el nombre.
# index.html NO: es el que dice cuáles son los nombres nuevos, y si se cachea,
# el navegador sigue pidiendo la versión vieja después de cada despliegue.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------- compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Que nadie liste el contenido de las carpetas.
Options -Indexes
