# Copia este archivo como `.env.production` y pon la dirección REAL de tu API
# antes de compilar el frontend con `pnpm run build`.
#
# Este valor se incrusta EN EL MOMENTO DE COMPILAR, no se lee al ejecutar: si lo
# cambias después, hay que volver a compilar y volver a subir la carpeta `dist`.
#
# Tiene que ser https:// — el navegador bloquea las llamadas de una página https
# hacia una API http ("mixed content"), y el síntoma es que el sitio carga pero
# ningún formulario guarda.
VITE_API_URL=https://tu-backend.fly.dev
