<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>UmesIsel.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ===================== Elevaciones por seguridad =====================
       Estas dos NO se usan directamente: entran como dependencias de otros
       paquetes, que las traen en versiones con CVE conocido. Se declaran aquí
       solo para forzar la versión parcheada (una referencia directa gana sobre
       la transitiva). Se verifica con "dotnet list package" pasándole los
       modificadores de paquetes vulnerables y transitivos, que debe salir limpio.

       · SixLabors.ImageSharp — PdfSharpCore 1.3.67 (la última que existe) pide
         la 1.0.4, que arrastra 7 avisos, 3 de severidad alta. La línea 1.x está
         abandonada y no tiene parche, así que se sube a la 2.1.x, que sigue bajo
         licencia Apache-2.0 (la 3.x cambió a una licencia comercial por tramos y
         no quiero meter ese problema legal aquí). Nuestro código solo usa
         PdfSharpCore para UNIR PDFs, nunca para decodificar imágenes, que es
         donde viven esos CVE — pero la app sí recibe imágenes del público (la
         foto de la solicitud de título), así que no se deja la versión vulnerable
         cargada en el proceso "porque no se llama".

       · SQLitePCLRaw — EF Core 8.0.11 trae la 2.1.6 (aviso de severidad alta en
         la librería nativa de SQLite). Se sube dentro de la misma línea 2.1.x
         para no salirse de lo que EF Core 8 soporta. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed data (student roster imported from the trimester Excel) travels with the build. -->
    <Content Update="Data\Seed\students.seed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Roster de la Actualización en Teología (hoja "Sacerdotes" del mismo Excel). Va aparte
         porque llegó después: se importa aunque la base ya tenga alumnos. -->
    <Content Update="Data\Seed\sacerdotes.seed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The official "Ficha de Asignación de Cursos" workbook — FichaXlsxBuilder fills a copy of
         this exact file cell-by-cell for printing, instead of approximating its layout in HTML.
         (Include, not Update: .xlsx isn't picked up by the SDK's implicit Content glob.) -->
    <Content Include="Resources\FichaTemplate.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Plantillas del módulo de Inscripción — los FORMATO .docx reales que dio el usuario, con
         tokens {{...}} insertados en los espacios en blanco (ver tools/docx-templates/prepare-*.mjs).
         Mismo trato que FichaTemplate.xlsx: se llenan y convierten a PDF sin tocar su diseño. -->
    <Content Include="Resources\PreinscripcionTemplate.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\CartaCompromisoTemplate.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- El FORMATO de "Solicitud de Impresión de Título", preparado igual (ver
         tools/docx-templates/prepare-solicitud-titulo.mjs). Además de tokens de texto lleva
         rejillas de una letra por casilla, casillas-imagen y un hueco para la fotografía. -->
    <Content Include="Resources\SolicitudTituloTemplate.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
