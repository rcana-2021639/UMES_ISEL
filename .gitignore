# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.env
frontend/.env.*
!frontend/.env.production.example
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# --- Local dev helper (machine-specific absolute paths, not portable) ---
dev-frontend.cmd

# --- Backend (.NET) ---
backend/**/bin/
backend/**/obj/
backend/**/*.user

# --- Backend SQLite database (generated at first run — see Data/DbInitializer.cs) ---
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal
backend/**/*.db.bak-*

# --- Documentos subidos (DPI, títulos, fotos...), clave de firma de sesiones y
#     respaldos de la base — NADA de App_Data va al repositorio ---
backend/**/App_Data/

# --- Editors / OS ---
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
